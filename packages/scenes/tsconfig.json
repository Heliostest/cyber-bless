{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@wbr/scene-runtime": ["../scene-runtime/src/index.ts"],
      "@wbr/scene-runtime/*": ["../scene-runtime/src/*.ts"]
    }
  },
  "include": ["src"]
}
