{
  "name": "world-blessing-rituals",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @wbr/cyber-bless --",
    "build": "npm run build -w @wbr/cyber-bless",
    "test": "npm run test -w @wbr/core && npm run test -w @wbr/runtime && npm run test -w @wbr/app && npm run test -w @wbr/gestures && npm run test -w @wbr/shared && npm run test -w @wbr/scenes && npm run test -w @wbr/content && npm run test -w @wbr/scene-runtime && node scripts/check-woodfish-assets.mjs",
    "mobile:start": "npm run start -w @wbr/mobile --",
    "mobile:remote": "npm run start -w @wbr/mobile -- --tunnel",
    "mobile:android": "npm run android -w @wbr/mobile",
    "mobile:ios": "npm run ios -w @wbr/mobile",
    "mobile:go": "npm run start -w @wbr/mobile -- --host lan",
    "mobile:go:tunnel": "npm run start -w @wbr/mobile -- --host tunnel",
    "mobile:verify": "npm run typecheck -w @wbr/mobile && npm exec -w @wbr/mobile -- expo install --check && node --test scripts/expo-dom-bootstrap.test.mjs scripts/validate-mobile-embed.test.mjs scripts/mobile-build-guard.test.mjs && node scripts/check-mobile-framework.mjs",
    "mobile:archive:verify": "node scripts/verify-eas-archive.mjs",
    "mobile:eas:android:preview": "node scripts/run-mobile-eas.mjs build -p android --profile preview",
    "mobile:eas:ios:preview": "node scripts/run-mobile-eas.mjs build -p ios --profile preview",
    "mobile:eas:android": "node scripts/run-mobile-eas.mjs build -p android --profile production",
    "mobile:eas:ios": "node scripts/run-mobile-eas.mjs build -p ios --profile production",
    "mobile:eas:ios:testflight": "node scripts/run-mobile-eas.mjs build -p ios --profile production --auto-submit",
    "mobile:eas:android:internal": "node scripts/run-mobile-eas.mjs build -p android --profile production --auto-submit",
    "mobile:eas:submit:ios": "node scripts/submit-mobile.mjs ios",
    "mobile:eas:submit:android": "node scripts/submit-mobile.mjs android",
    "verify": "npm test && npm run build && npm run mobile:verify",
    "content:publish": "node scripts/publish-scene-content.mjs",
    "mobile:eas:status": "node scripts/mobile-build-status.mjs",
    "mobile:eas:submissions": "node scripts/mobile-submission-status.mjs",
    "mobile:store:status": "node scripts/app-store-status.mjs",
    "mobile:store:prepare": "node scripts/prepare-app-store.mjs",
    "mobile:store:contact": "node scripts/set-app-store-review-contact.mjs",
    "mobile:store:legal": "node scripts/set-app-store-legal-urls.mjs",
    "mobile:store:content-rights": "node scripts/set-app-store-content-rights.mjs",
    "mobile:store:screenshots": "node scripts/upload-app-store-screenshots.mjs",
    "mobile:store:screenshots:capture": "node scripts/capture-iphone-screenshots.mjs",
    "mobile:testflight:prepare": "node scripts/prepare-testflight.mjs",
    "mobile:play:assets": "node scripts/prepare-play-assets.mjs",
    "mobile:legal:prepare": "node scripts/prepare-legal-site.mjs",
    "mobile:legal:notion": "node scripts/prepare-notion-legal-pages.mjs",
    "mobile:widgets:test": "npm run test -w @wbr/core -- src/widgets.test.ts && npm run test -w @wbr/runtime -- src/projected-storage.test.ts && npm run test -w @wbr/app -- src/widget-navigation.test.ts && node --test scripts/blessing-widgets-plugin.test.mjs scripts/blessing-widgets-native.test.mjs scripts/mobile-widgets-ios.test.mjs scripts/mobile-widget-images.test.mjs scripts/mobile-widget-previews.test.mjs",
    "mobile:widgets:render": "node scripts/render-widget-previews.mjs",
    "mobile:dev-client": "npm run start:dev-client -w @wbr/mobile --",
    "mobile:android:debug": "node scripts/build-mobile-android-debug.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "sharp": "^0.34.5"
  }
}
