{
  "name": "@wbr/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "assets:prepare": "node ../../scripts/i18n-compile.mjs && node ../../scripts/prepare-app-assets.mjs",
    "prestart": "npm run assets:prepare",
    "preandroid": "npm run assets:prepare",
    "preios": "npm run assets:prepare",
    "preweb": "npm run assets:prepare",
    "eas-build-post-install": "npm --prefix ../.. run i18n:verify && npm run assets:prepare",
    "start": "expo start --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "start:dev-client": "expo start --dev-client",
    "prestart:dev-client": "npm run assets:prepare"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "~57.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@wbr/app": "*",
    "@wbr/content": "*",
    "@wbr/core": "*",
    "@wbr/runtime": "*",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.19",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-localization": "57.0.2",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-widgets": "~57.0.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "@wbr/i18n": "*"
  },
  "devDependencies": {
    "@expo/ngrok": "npm:expo-cloudflared@^4.2.2",
    "@types/react": "~19.2.4",
    "eas-cli": "24.12.1",
    "typescript": "~6.0.3"
  }
}
